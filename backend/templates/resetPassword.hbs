<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Reset Your Password</title>
    <style>
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f4f4f4;
        margin: 0;
        padding: 0;
      }
    </style>
  </head>
  <body style="margin:0;padding:0;background-color:#f4f4f4;">
    <table align="center" cellpadding="0" cellspacing="0" width="100%" style="max-width:600px; margin:auto; background-color:#ffffff; border-radius:8px; box-shadow:0 4px 10px rgba(0,0,0,0.1);">
      <tr>
        <td align="center" style="padding:40px 30px 20px 30px;">
          <h2 style="color:#333333; margin:0;">Password Reset Request</h2>
        </td>
      </tr>
      <tr>
        <td style="padding:0 30px 30px 30px;">
          <p style="font-size:16px; color:#555555; line-height:1.6;">
            Hi <strong>{{username}}</strong>,
          </p>
          <p style="font-size:16px; color:#555555; line-height:1.6;">
            We received a request to reset your password. Click the button below to set a new password.
            This link is valid for <strong>5 minutes only</strong>.
          </p>

          <div style="text-align:center; margin:30px 0;">
            <a href="{{resetLink}}"
               style="display:inline-block; background:#4F46E5; color:#ffffff; padding:14px 32px; border-radius:6px; font-size:16px; font-weight:bold; text-decoration:none; letter-spacing:0.5px;">
              Reset Password
            </a>
          </div>

          <p style="font-size:14px; color:#888888; line-height:1.6;">
            Or copy and paste this link into your browser:
          </p>
          <p style="font-size:13px; color:#4F46E5; word-break:break-all;">
            {{resetLink}}
          </p>

          <p style="font-size:14px; color:#999999; text-align:center; margin-top:24px;">
            If you didn't request a password reset, you can safely ignore this email.<br/>
            Your password will not be changed.
          </p>
        </td>
      </tr>
      <tr>
        <td align="center" style="background-color:#f4f4f4; padding:20px 30px; border-top:1px solid #dddddd;">
          <p style="font-size:12px; color:#999999; margin:0;">
            © {{year}} YourApp. All rights reserved.
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
